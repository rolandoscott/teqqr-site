# Cloudflare response headers (read at deploy time, not served as a file).
# HTML, CSS and JS keep the default revalidation so edits show up immediately.

# Font files never change; if one is ever replaced, give it a new filename.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=2592000

/images/*
  Cache-Control: public, max-age=2592000
